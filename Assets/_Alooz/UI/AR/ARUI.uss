.ar-root {
    flex-grow: 1;

    justify-content: space-between;

    padding-top: 18px;
    padding-right: 14px;
    padding-bottom: 14px;
    padding-left: 14px;
}


/* =========================
   TOP BAR
========================= */

.top-bar {
    width: 100%;
    height: 52px;

    flex-direction: row;
    align-items: center;
    justify-content: space-between;

    padding-left: 16px;
    padding-right: 7px;

    background-color: rgba(11, 31, 51, 0.92);

    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
}


.app-title {
    color: white;

    font-size: 18px;

    -unity-font-style: bold;
}


.icon-button {
    width: 38px;
    min-width: 38px;
    max-width: 38px;

    height: 38px;
    min-height: 38px;
    max-height: 38px;

    flex-grow: 0;
    flex-shrink: 0;

    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;

    background-color: rgba(255, 255, 255, 0.10);

    color: white;

    font-size: 18px;

    -unity-text-align: middle-center;

    border-top-left-radius: 19px;
    border-top-right-radius: 19px;
    border-bottom-left-radius: 19px;
    border-bottom-right-radius: 19px;
}


/* =========================
   BOTTOM SHEET
========================= */

.bottom-sheet {
    width: 100%;

    flex-shrink: 0;

    background-color: rgba(11, 31, 51, 0.96);

    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;

    overflow: hidden;
}


/* =========================
   HEADER
========================= */

.sheet-header {
    width: 100%;
    height: 52px;

    flex-direction: row;
    align-items: center;
    justify-content: space-between;

    padding-left: 16px;
    padding-right: 7px;

    background-color: rgba(255, 255, 255, 0.03);
}


.product-title {
    flex-grow: 1;
    flex-shrink: 1;

    min-width: 0;

    color: white;

    font-size: 16px;

    -unity-font-style: bold;
}


.sheet-toggle-button {
    width: 38px;
    min-width: 38px;
    max-width: 38px;

    height: 38px;
    min-height: 38px;
    max-height: 38px;

    flex-grow: 0;
    flex-shrink: 0;

    background-color: rgba(255, 255, 255, 0.08);

    color: rgb(255, 181, 102);

    font-size: 17px;

    border-top-left-radius: 19px;
    border-top-right-radius: 19px;
    border-bottom-left-radius: 19px;
    border-bottom-right-radius: 19px;
}


/* =========================
   CONTENT
========================= */

.sheet-content {
    width: 100%;

    padding-left: 16px;
    padding-right: 16px;
    padding-bottom: 14px;
}


.collapsed {
    display: none;
}


/* =========================
   LABELS
========================= */

.section-label {
    color: rgb(220, 229, 237);

    font-size: 12px;

    margin-top: 10px;
    margin-bottom: 7px;
}


/* =========================
   COLORS
========================= */

.color-row {
    width: 100%;

    flex-direction: row;
    align-items: center;

    margin-bottom: 4px;
}


.color-button {
    width: 34px;
    min-width: 34px;
    max-width: 34px;

    height: 34px;
    min-height: 34px;
    max-height: 34px;

    margin-right: 10px;

    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;

    border-top-color: rgba(255, 255, 255, 0.28);
    border-right-color: rgba(255, 255, 255, 0.28);
    border-bottom-color: rgba(255, 255, 255, 0.28);
    border-left-color: rgba(255, 255, 255, 0.28);

    border-top-left-radius: 17px;
    border-top-right-radius: 17px;
    border-bottom-left-radius: 17px;
    border-bottom-right-radius: 17px;
}


.color-white {
    background-color: rgb(245, 245, 245);
}


.color-black {
    background-color: rgb(20, 20, 20);
}


.color-gray {
    background-color: rgb(120, 120, 120);
}


.color-red {
    background-color: rgb(200, 45, 45);
}


.color-blue {
    background-color: rgb(35, 85, 160);
}


.color-orange {
    background-color: rgb(255, 181, 102);
}


/* =========================
   CONTROLS
========================= */

.control-row {
    width: 100%;

    flex-direction: row;
    align-items: center;
    justify-content: space-between;

    margin-top: 12px;
}


.control-label {
    width: 82px;
    min-width: 82px;

    color: rgb(220, 229, 237);

    font-size: 12px;
}


/* =========================
   LIGHT
========================= */

.light-button {
    width: 82px;
    min-width: 82px;
    max-width: 82px;

    height: 38px;
    min-height: 38px;
    max-height: 38px;

    background-color: rgba(255, 255, 255, 0.10);

    color: white;

    font-size: 11px;

    -unity-font-style: bold;

    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}


.light-button-on {
    background-color: rgb(255, 181, 102);

    color: rgb(11, 31, 51);
}


/* =========================
   BUTTONS
========================= */

.primary-button {
    width: 100%;

    height: 42px;

    margin-top: 14px;

    background-color: rgb(255, 181, 102);

    color: rgb(11, 31, 51);

    font-size: 13px;

    -unity-font-style: bold;

    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}


.secondary-button {
    width: 100%;

    height: 42px;

    margin-top: 8px;

    background-color: rgba(255, 255, 255, 0.10);

    color: white;

    font-size: 13px;

    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}


/* =========================
   UI TOUCH BLOCK
========================= */

.blocks-ar {
}